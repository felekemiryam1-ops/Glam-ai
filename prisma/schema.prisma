// Glam AI — Prisma schema
// Dev:  SQLite  — set DATABASE_URL="file:./dev.db"
// Prod: Postgres — set DATABASE_URL="postgresql://..."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // url is no longer set here in Prisma 7 — see prisma.config.ts
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth.js required models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  beautyProfile BeautyProfile?
  reports       Report[]
  subscription  Subscription?

  routineCheckIns RoutineCheckIn[]
  progressPhotos  ProgressPhoto[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Glam AI domain models
// ─────────────────────────────────────────────────────────────────────────────

// Persistent beauty profile — built up over time from analyses and preferences
model BeautyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding preferences (JSON arrays stored as strings in SQLite)
  goals     String? // JSON: string[] — e.g. ["everyday glow-up","better makeup"]
  aesthetic String? // e.g. "soft glam"
  budget    String? // "budget" | "mid-range" | "premium"

  // Latest AI-derived profile summaries (updated after each analysis)
  colorProfile  String? // JSON: ColorProfile
  makeupProfile String? // JSON: MakeupProfile
  hairProfile   String? // JSON: HairProfile

  // ── Skin & Hair Glow-Up (Pro/Premium) ─────────────────────────────────
  // Intake: short self-reported inputs, collected contextually the first
  // time a subscriber opens Skin/Hair Glow-Up. Deliberately NOT part of the
  // general onboarding wizard — irrelevant to $4.99 buyers.
  skinType     String? // "dry" | "oily" | "combination" | "normal" | "sensitive"
  skinConcerns String? // JSON: string[] — 1-3 selected concerns
  hairType     String? // "straight" | "wavy" | "curly" | "coily"
  hairConcerns String? // JSON: string[] — 1-3 selected concerns

  // Cached generated plans. Text-only Claude output, regenerated ONLY on
  // first intake submit, an explicit user refresh, or an intake change —
  // never on a page view. The *UpdatedAt columns are what let that caching
  // rule be enforced and displayed ("updated 3 days ago").
  skinPlan          String? // JSON: SkinPlan
  skinPlanUpdatedAt DateTime?
  hairPlan          String? // JSON: HairPlan
  hairPlanUpdatedAt DateTime?

  // ── Monthly Glow-Up (Premium) ──────────────────────────────────────────
  // Cached output of a Premium check-in — same pattern as skinPlan/hairPlan
  // above: generated only on explicit POST /api/monthly-glow-up, read
  // verbatim on GET (zero Claude calls). Deliberately not a separate
  // check-in table — the summary itself IS the durable record of a
  // check-in; see app/api/monthly-glow-up/route.ts for the full reasoning.
  monthlyGlowUp          String? // JSON: MonthlyGlowUpSummary
  monthlyGlowUpUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Every AI-generated report, linked to the user who owns it.
// userId is nullable so anonymous $4.99 buyers get a Report row
// that can later be "claimed" when they create an account.
model Report {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // "glow_up" for the $4.99 product; "pro_analysis" for future Pro re-analyses
  type String @default("glow_up")

  // The Stripe checkout session that paid for this report (unique — prevents reuse)
  stripeSessionId String? @unique

  // Full GlamReport JSON from /api/analyze
  data String // JSON: GlamReport

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Curated product catalog for makeup-recommendation matching (Stage 5A).
// Deliberately minimal — see docs/plans for the full architecture rationale:
// one flat table, no ProductVariant/ProductRecommendation/SavedProduct yet.
// Matching itself is computed at request time (lib/productMatching.ts) and
// nothing here is written by that code path — this table is read-only from
// the app's perspective, populated only by the seed script.
model Product {
  id    String @id @default(cuid())
  brand String
  name  String

  // "blush" | "eyeshadow" | "lipstick" | "lip gloss" — matches MakeupPlan's
  // cheeks/eyes/lips slots (see lib/productMatching.ts's category mapping).
  category String

  shadeName String

  // Nullable — real product data rarely publishes a hex; matching degrades
  // gracefully to shade-name/undertone comparison when absent (see
  // lib/productMatching.ts). Never fabricated.
  hex String?

  // "warm" | "cool" | "neutral" | "universal" | null (unclear)
  undertone String?

  priceCents Int
  currency   String @default("usd")

  imageUrl   String?
  retailer   String
  productUrl String

  // Reserved for a future affiliate relationship — unused today. Nullable
  // so the UI can always fall back to productUrl (see architecture plan §6).
  affiliateUrl String?

  tags String? // JSON string[] — reserved, not used by MVP matching

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Natural key for idempotent seeding — the same real-world product/shade
  // should never be inserted twice by re-running the seed.
  @@unique([brand, name, shadeName])
  @@index([category, undertone, active])
}

// Stripe subscription record — one per user at most
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String  @unique
  stripeSubscriptionId String? @unique

  // "pro" | "premium"
  plan   String
  // mirrors Stripe: "active" | "canceled" | "past_due" | "trialing" | "incomplete"
  status String

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Routine Tracking (Premium, Stage 6 Step 6). One row per user/day/category
// completion — genuinely event-like history (did X happen on day Y), unlike
// skinPlan/hairPlan above which represent "current state" and are correctly
// a single JSON blob. "Reset for a new day" needs no explicit logic: a new
// calendar date simply has no rows yet, so completion reads as false by
// absence — nothing to clear.
model RoutineCheckIn {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime // calendar day this check-in is for, truncated to midnight UTC

  // "skin_am" | "skin_pm" | "hair" | "makeup" — matches Beauty Routine's
  // existing section categories (Step 5), not a new vocabulary.
  category  String
  completed Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([userId, date, category])
  @@index([userId, date])
}

// Progress Photos (Premium, Stage 6 Step 6). User-added photos over time,
// distinct from Report's paid-generation history — a person tracking their
// own transformation, not another paid Glow-Up. imageUrl is a FAL storage
// URL, uploaded server-side only after auth + magic-byte validation (see
// app/api/progress-photos/route.ts) — never a client-supplied URL.
model ProgressPhoto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl String
  note     String? // optional short caption, user-supplied

  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, takenAt])
}
